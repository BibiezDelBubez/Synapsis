Options -Indexes
AddDefaultCharset UTF-8
AddType application/javascript .mjs

# JS e CSS vengono sempre riconvalidati: dopo un aggiornamento non serve Ctrl+F5
<IfModule mod_headers.c>
    <FilesMatch "\.(js|mjs|css)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # File e cartelle esistenti (css, js, vendor) vengono serviti direttamente
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Tutto il resto passa dal front controller
    RewriteRule ^ index.php [QSA,L]
</IfModule>
